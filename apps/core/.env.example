# Site Guardian Core configuration. Copy to .env and fill in real values.

# Supabase (local dev values come from `supabase status -o env`)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
# Direct Postgres connection (used by the Postgres-backed rate limiter)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Anthropic. Required unless AI_STUB=true.
ANTHROPIC_API_KEY=replace-with-anthropic-api-key
ANTHROPIC_MODEL=claude-opus-5-5

# Public base URL of this Core instance
CORE_PUBLIC_URL=http://localhost:8787

# Optional
PORT=8787
# Comma-separated browser origins allowed by CORS. Empty = CORS closed.
CORS_ALLOWED_ORIGINS=
# Dev only: allow localhost/IP-literal site URLs. Startup fails if true with NODE_ENV=production.
ALLOW_LOCAL_SITES=false
# Dev/test only: use a canned AI instead of Anthropic. Startup fails if true with NODE_ENV=production.
AI_STUB=false
NODE_ENV=development
LOG_LEVEL=info
