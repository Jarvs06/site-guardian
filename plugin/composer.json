{
    "name": "site-guardian/plugin",
    "description": "Site Guardian WordPress plugin.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "brain/monkey": "^2.6",
        "wp-coding-standards/wpcs": "^3.0",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "SiteGuardian\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SiteGuardian\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs"
    }
}
