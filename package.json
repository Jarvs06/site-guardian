{
  "name": "site-guardian",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm --filter @sg/shared build && pnpm -r --workspace-concurrency=1 typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "build": "pnpm -r --workspace-concurrency=1 build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@supabase/supabase-js": "^2.119.2",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.0",
    "pg": "^8.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
